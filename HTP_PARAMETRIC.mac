! ================================================================
!  BLOCK 1: PARAMETRIC INPUT VARIABLES 
! ================================================================
! Test git next round experiment branch new chamge?
CONFIG = 1  ! 1 = Config A (14-3-8), 2 = Config B (9-2-8), 3 = Config C (7-2-6)

! --- FIXED MACRO-GEOMETRY [mm] (DO NOT OPTIMIZE) ---
SPAN    = 3978
C_ROOT  = 3090
C_TIP   = 1860
DIHED   = 7
TC      = 0.12

! --- TOPOLOGICAL LAYOUT SELECTOR ---
*IF,CONFIG,EQ,1,THEN
    N_RIB  = 14
    N_SPAR = 3
    N_STR  = 8
    N_CUT  = 7
*ELSEIF,CONFIG,EQ,2
    N_RIB  = 9
    N_SPAR = 2
    N_STR  = 8
    N_CUT  = 6
*ELSEIF,CONFIG,EQ,3
    N_RIB  = 7
    N_SPAR = 2
    N_STR  = 6
    N_CUT  = 4
*ENDIF

! ================================================================
! DESIGN VARIABLES (DVs) FOR SIZING OPTIMIZATION
! (These are Initial Guesses. The Optimizer will iterate these values)
! ================================================================

! --- Thicknesses [mm] ---
T_SKIN     = 2.5    ! Composite skin thickness
T_SPAR_WEB = 3.0    ! Spar web thickness
T_RIB_WEB  = 2.0    ! Rib web thickness

! --- Hat-Section Stringer Dimensions [mm] ---
STR_H   = 50        ! Stringer Height (W4)
STR_W3  = 40        ! Stringer Crown Width (W3)
STR_BRIM = 15       ! Stringer Brim Width (W1, W2)
STR_T   = 3.0       ! Stringer Thickness

! --- Spar Flange Dimensions [mm] ---
SPAR_FW = 50.0      ! Spar Flange Width
SPAR_FT = 4.0       ! Spar Flange Thickness

! ================================================================
! MESH & MICRO-DETAILS CONSTANTS
! ================================================================
ESIZE_V = 100
HOLE_RATIO = 0.50   ! Lightening hole diameter is 50% of local rib height

! ================================================================
! MATERIAL PROPERTIES (Unit System: N, mm, tonne, MPa)
! ================================================================

! --- Material 1: Al 7075-T6 (Internal Framework) ---
EX_AL   = 71700     ! Young's Modulus [MPa]
PRXY_AL = 0.33      ! Poisson's Ratio
DENS_AL = 2.81e-9   ! Density [tonne/mm^3]
SY_AL   = 480       ! Tensile Yield Strength [MPa]

! --- Material 2: Equivalent Isotropic Composite (Skins) ---
EX_COMP = 50000     ! Young's Modulus [MPa]
PRXY_CO = 0.28      ! Poisson's Ratio
DENS_CO = 1.6e-9    ! Density [tonne/mm^3]

PI = ACOS(-1)
DIHED_R = DIHED*PI/180

! ================================================================
!  BLOCK 2: STATION CALCULATION & AIRFOIL
! ================================================================
RIB_SPC = SPAN/(N_RIB - 1)
*DIM,Y_STA,ARRAY,N_RIB
*DIM,C_STA,ARRAY,N_RIB
*DIM,Z_OFF,ARRAY,N_RIB

*DO,I,1,N_RIB
    Y_STA(I) = (I-1)*RIB_SPC
    C_STA(I) = C_ROOT + (C_TIP - C_ROOT)*Y_STA(I)/SPAN
    Z_OFF(I) = Y_STA(I)*TAN(DIHED_R)
*ENDDO

! Define topological points for Upper Surface
N_UP = 25
*DIM,XC_UP,ARRAY,N_UP
XC_UP(1)  = 0.00, 0.02, 0.05, 0.08, 0.10, 0.12, 0.15, 0.18
XC_UP(9)  = 0.21, 0.25, 0.28, 0.31, 0.35, 0.40, 0.45, 0.50
XC_UP(17) = 0.55, 0.60, 0.65, 0.70, 0.75, 0.80, 0.85, 0.90
XC_UP(25) = 0.98

*DIM,IS_SPAR,ARRAY,N_UP
*DIM,IS_STR,ARRAY,N_UP
*DO,I,1,N_UP
    IS_SPAR(I) = 0
    IS_STR(I) = 0
*ENDDO

*IF,CONFIG,EQ,1,THEN
    IS_SPAR(7) = 1  ! 0.15
    IS_SPAR(16) = 1 ! 0.50
    IS_SPAR(20) = 1 ! 0.70
    IS_STR(9)  = 1  ! 0.21
    IS_STR(11) = 1  ! 0.28
    IS_STR(13) = 1  ! 0.35
    IS_STR(14) = 1  ! 0.40
*ELSEIF,CONFIG,EQ,2,THEN
    IS_SPAR(7) = 1
    IS_SPAR(16) = 1
    IS_STR(10) = 1
    IS_STR(13) = 1
    IS_STR(15) = 1
    IS_STR(18) = 1
*ELSEIF,CONFIG,EQ,3,THEN
    IS_SPAR(7) = 1
    IS_SPAR(16) = 1
    IS_STR(10) = 1
    IS_STR(15) = 1
    IS_STR(18) = 1
*ENDIF

! Construct Full Profile (Upper + Lower)
N_PROF = 2*N_UP - 1
*DIM,XC_FRAC,ARRAY,N_PROF
*DIM,Y_SGN,ARRAY,N_PROF
*DIM,PROF_SPAR,ARRAY,N_PROF
*DIM,PROF_STR,ARRAY,N_PROF

! Upper Surface (LE to TE)
*DO,I,1,N_UP
    XC_FRAC(I) = XC_UP(I)
    Y_SGN(I) = 1.0
    PROF_SPAR(I) = IS_SPAR(I)
    PROF_STR(I) = IS_STR(I)
*ENDDO

! Lower Surface (TE to LE)
IDX = N_UP
*DO,I,N_UP,2,-1
    IDX = IDX + 1
    XC_FRAC(IDX) = XC_UP(I)
    Y_SGN(IDX) = -1.0
    PROF_SPAR(IDX) = IS_SPAR(I)
    PROF_STR(IDX) = IS_STR(I)
*ENDDO

! NACA Polynomial Thickness
*DIM,YT_FRAC,ARRAY,N_PROF
TSCALE = TC/0.20
*DO,J,1,N_PROF
    XF = XC_FRAC(J)
    *IF,XF,GT,0,THEN
        T1 = 0.29690*SQRT(XF)
        T2 = 0.12600*XF
        T3 = 0.35160*(XF**2)
        T4 = 0.28430*(XF**3)
        T5 = 0.10150*(XF**4)
        YT_FRAC(J) = TSCALE*(T1 - T2 - T3 + T4 - T5)
    *ELSE
        YT_FRAC(J) = 0.0
    *ENDIF
*ENDDO

! ================================================================
!  BLOCK 3: SPAR-AWARE HOLE BAY DEFINITION
! ================================================================
*DIM, BAY_START, ARRAY, N_SPAR
*DIM, BAY_END, ARRAY, N_SPAR
*DIM, BAY_HOLES, ARRAY, N_SPAR

SPAR_CNT = 0
PREV_XC = 0.0
*DO,J,1,N_UP
    *IF, IS_SPAR(J), EQ, 1, THEN
        SPAR_CNT = SPAR_CNT + 1
        *IF, SPAR_CNT, EQ, 1, THEN
            BAY_START(1) = 0.0
            BAY_END(1) = XC_UP(J)
            BAY_HOLES(1) = 0  ! DISABLE holes in sharp Leading Edge (prevents sliver mesh errors)
            PREV_XC = XC_UP(J)
        *ELSEIF, SPAR_CNT, EQ, 2, THEN
            BAY_START(2) = PREV_XC
            BAY_END(2) = XC_UP(J)
            *IF, CONFIG, EQ, 1, THEN
                BAY_HOLES(2) = 5
            *ELSE
                BAY_HOLES(2) = N_CUT
            *ENDIF
            PREV_XC = XC_UP(J)
        *ELSEIF, SPAR_CNT, EQ, 3, THEN
            BAY_START(3) = PREV_XC
            BAY_END(3) = XC_UP(J)
            BAY_HOLES(3) = 0  ! DISABLE holes in Trailing Edge bay
        *ENDIF
    *ENDIF
*ENDDO

! ================================================================
!  BLOCK 4: KEYPOINTS & LINE GENERATION
! ================================================================
/PREP7
*DO,I,1,N_RIB
    Y_I = Y_STA(I)
    C_I = C_STA(I)
    Z_I = Z_OFF(I)
    KP_BASE = (I-1)*100
    *DO,J,1,N_PROF
        X_KP = XC_FRAC(J)*C_I
        Z_KP = Z_I + Y_SGN(J)*YT_FRAC(J)*C_I
        K, KP_BASE + J, X_KP, Y_I, Z_KP
    *ENDDO
*ENDDO

! --- Temporarily Disable Stringers and Flanges ---
    ! --- Create Upper Stringer Lines ---
    *GET, L_MAX_PRE, LINE, 0, NUM, MAXD
    *DO,I,1,N_RIB-1
        KB1 = (I-1)*100
        KB2 = I*100
        *DO,J,1,N_UP
            *IF, PROF_STR(J), EQ, 1, THEN
                L, KB1+J, KB2+J
            *ENDIF
        *ENDDO
    *ENDDO
    *GET, L_MAX_POST, LINE, 0, NUM, MAXD
    *IF, L_MAX_POST, GT, L_MAX_PRE, THEN
        LSEL, S, LINE, , L_MAX_PRE+1, L_MAX_POST
        CM, COMP_STR_UPPER, LINE
    *ENDIF
    ALLSEL, ALL
    
    ! --- Create Lower Stringer Lines ---
    *GET, L_MAX_PRE, LINE, 0, NUM, MAXD
    *DO,I,1,N_RIB-1
        KB1 = (I-1)*100
        KB2 = I*100
        *DO,J,N_UP+1,N_PROF
            *IF, PROF_STR(J), EQ, 1, THEN
                L, KB1+J, KB2+J
            *ENDIF
        *ENDDO
    *ENDDO
    *GET, L_MAX_POST, LINE, 0, NUM, MAXD
    *IF, L_MAX_POST, GT, L_MAX_PRE, THEN
        LSEL, S, LINE, , L_MAX_PRE+1, L_MAX_POST
        CM, COMP_STR_LOWER, LINE
    *ENDIF
    ALLSEL, ALL
    
    ! --- Create Upper Spar Flange Lines ---
    *GET, L_MAX_PRE, LINE, 0, NUM, MAXD
    *DO,I,1,N_RIB-1
        KB1 = (I-1)*100
        KB2 = I*100
        *DO,J,1,N_UP
            *IF, PROF_SPAR(J), EQ, 1, THEN
                L, KB1+J, KB2+J
            *ENDIF
        *ENDDO
    *ENDDO
    *GET, L_MAX_POST, LINE, 0, NUM, MAXD
    *IF, L_MAX_POST, GT, L_MAX_PRE, THEN
        LSEL, S, LINE, , L_MAX_PRE+1, L_MAX_POST
        CM, COMP_FLANGE_UPPER, LINE
    *ENDIF
    ALLSEL, ALL
    
    ! --- Create Lower Spar Flange Lines ---
    *GET, L_MAX_PRE, LINE, 0, NUM, MAXD
    *DO,I,1,N_RIB-1
        KB1 = (I-1)*100
        KB2 = I*100
        *DO,J,N_UP+1,N_PROF
            *IF, PROF_SPAR(J), EQ, 1, THEN
                L, KB1+J, KB2+J
            *ENDIF
        *ENDDO
    *ENDDO
    *GET, L_MAX_POST, LINE, 0, NUM, MAXD
    *IF, L_MAX_POST, GT, L_MAX_PRE, THEN
        LSEL, S, LINE, , L_MAX_PRE+1, L_MAX_POST
        CM, COMP_FLANGE_LOWER, LINE
    *ENDIF
    ALLSEL, ALL

! ================================================================
!  BLOCK 5: AREA GENERATION (RIBS -> HOLES -> SKINS -> SPARS)
! ================================================================
! --- Ribs (Solid first) ---
/GOPR
*GET, A_MAX_PRE, AREA, 0, NUM, MAXD
*DO,I,1,N_RIB
    ALLSEL, ALL
    KB = (I-1)*100
    *GET, L_MAX_PRE, LINE, 0, NUM, MAXD
    *DO,J,1,N_PROF-1
        L, KB+J, KB+J+1
    *ENDDO
    L, KB+N_PROF, KB+1
    *GET, L_MAX_POST, LINE, 0, NUM, MAXD
    LSEL, S, LINE, , L_MAX_PRE+1, L_MAX_POST
    
    CM, TEMP_PRE_RIB_AREAS, AREA
    AL, ALL
    
    ! Get the ID of the newly created Rib area robustly
    CMSEL, U, TEMP_PRE_RIB_AREAS
    *GET, AR_RIB, AREA, 0, NUM, MAX
    CMSEL, A, TEMP_PRE_RIB_AREAS
    
    ! Lightening Cutouts
    WPCSYS, -1, 0
    WPOFFS, 0, Y_STA(I), 0
    WPROTA, 0, 90, 0
    C_I = C_STA(I)
    Z_I = Z_OFF(I)

    ALLSEL, ALL
    CM, TEMP_PRE_AREAS, AREA
    
    ! --- Max-Ratio Hole Generation ---
    *IF, N_CUT, EQ, 7, THEN
        ! Config 1 (4 Stringers between Spar 1 and 2)
        ! Gaps are calculated to exactly touch the stringer brims and spar flanges
        CYL4, 0.080*C_I, Z_I, 0.035*C_I  ! LE to Spar 1 (Max limited by thickness)
        CYL4, 0.180*C_I, Z_I, 0.015*C_I  ! Spar 1(0.15) to Str 1(0.21)
        CYL4, 0.245*C_I, Z_I, 0.015*C_I  ! Str 1(0.21) to Str 2(0.28)
        CYL4, 0.315*C_I, Z_I, 0.015*C_I  ! Str 2(0.28) to Str 3(0.35)
        CYL4, 0.375*C_I, Z_I, 0.015*C_I  ! Str 3(0.35) to Str 4(0.40)
        CYL4, 0.450*C_I, Z_I, 0.025*C_I  ! Str 4(0.40) to Spar 2(0.50)
        CYL4, 0.600*C_I, Z_I, 0.040*C_I  ! Spar 2(0.50) to Spar 3(0.70)
    *ELSEIF, N_CUT, EQ, 6, THEN
        CYL4, 0.08*C_I, Z_I, 0.018*C_I
        CYL4, 0.20*C_I, Z_I, 0.025*C_I
        CYL4, 0.30*C_I, Z_I, 0.030*C_I
        CYL4, 0.425*C_I, Z_I, 0.030*C_I
        CYL4, 0.55*C_I, Z_I, 0.030*C_I
        CYL4, 0.65*C_I, Z_I, 0.025*C_I
    *ELSEIF, N_CUT, EQ, 4, THEN
        CYL4, 0.08*C_I, Z_I, 0.018*C_I
        CYL4, 0.25*C_I, Z_I, 0.030*C_I
        CYL4, 0.425*C_I, Z_I, 0.030*C_I
        CYL4, 0.60*C_I, Z_I, 0.030*C_I
    *ENDIF
    
    ALLSEL, ALL
    CMSEL, U, TEMP_PRE_AREAS
    *GET, N_HOLES, AREA, 0, COUNT
    
    *IF, N_HOLES, GT, 0, THEN
        ASEL, A, AREA, , AR_RIB
        ASBA, AR_RIB, ALL
    *ENDIF
    WPCSYS, -1, 0
*ENDDO
ALLSEL, ALL
*GET, A_MAX_POST, AREA, 0, NUM, MAXD
ASEL, S, AREA, , A_MAX_PRE+1, A_MAX_POST
CM, COMP_RIBS, AREA
ALLSEL, ALL

! --- Skins ---
ALLSEL, ALL
CM, TEMP_PRE_SKINS, AREA

*DO,I,1,N_RIB-1
    KB1 = (I-1)*100
    KB2 = I*100
    *DO,J,1,N_PROF-1
        A, KB1+J, KB2+J, KB2+J+1, KB1+J+1
    *ENDDO
    A, KB1+N_PROF, KB2+N_PROF, KB2+1, KB1+1
*ENDDO

ALLSEL, ALL
CMSEL, U, TEMP_PRE_SKINS
CM, COMP_SKINS, AREA
ALLSEL, ALL

! --- Spar Webs ---
ALLSEL, ALL
CM, TEMP_PRE_SPARS, AREA

*DO,I,1,N_RIB-1
    KB1 = (I-1)*100
    KB2 = I*100
    *DO,J,1,N_UP
        *IF, IS_SPAR(J), EQ, 1, THEN
            *IF, J, EQ, 1, THEN
                J_LOW = 1
            *ELSEIF, J, EQ, N_UP, THEN
                J_LOW = N_UP
            *ELSE
                J_LOW = N_PROF - J + 2
            *ENDIF
            A, KB1+J, KB2+J, KB2+J_LOW, KB1+J_LOW
        *ENDIF
    *ENDDO
*ENDDO

ALLSEL, ALL
CMSEL, U, TEMP_PRE_SPARS
CM, COMP_SPARS, AREA
ALLSEL, ALL

! Merge topology
NUMMRG, ALL, 1.0E-4
NUMCMP, ALL

! ================================================================
!  BLOCK 7: ELEMENT TYPES, MATERIALS & SECTIONS
! ================================================================
ET, 1, SHELL181
KEYOPT, 1, 3, 2

ET, 2, BEAM188
KEYOPT, 2, 3, 3

MP, EX, 1, EX_AL
MP, PRXY, 1, PRXY_AL
MP, DENS, 1, DENS_AL

MP, EX, 2, EX_COMP
MP, PRXY, 2, PRXY_CO
MP, DENS, 2, DENS_CO

SECTYPE, 1, SHELL
SECDATA, T_RIB_WEB, 1

SECTYPE, 2, SHELL
SECDATA, T_SPAR_WEB, 1

SECTYPE, 3, SHELL
SECDATA, T_SKIN, 2

SECTYPE, 4, BEAM, HATS
SECDATA, STR_BRIM, STR_BRIM, STR_W3, STR_H, STR_T, STR_T, STR_T, STR_T, STR_T
*GET, STR_YC, SECP, 4, PROP, CGY
SECOFFSET, USER, STR_YC, 0    ! Centered horizontally, visually flush with skin (brims at node plane)

SECTYPE, 5, BEAM, RECT
SECDATA, SPAR_FW, SPAR_FT
FL_OFFZ = -1*(SPAR_FT/2)       ! Visually flush with the node plane (ignores T_SKIN/2 gap)
SECOFFSET, USER, 0, FL_OFFZ    ! local z = inward skin normal

! ================================================================
!  SAVE DB FOR GEOMETRY INSPECTION
! ================================================================
SAVE, 'HTP_PARAMETRIC', 'db'

! ================================================================
!  BLOCK 8: MESHING
! ================================================================
ESIZE_V = 100
ESIZE, ESIZE_V

! Skins
CMSEL, S, COMP_SKINS
AATT, 2, , 1, , 3
MSHAPE, 0, 2D
MSHKEY, 1
AMESH, ALL

! Spar Webs
CMSEL, S, COMP_SPARS
AATT, 1, , 1, , 2
MSHAPE, 0, 2D
MSHKEY, 1
AMESH, ALL

! Refine hole lines
CMSEL, S, COMP_RIBS
LSLA, S
CMSEL, S, COMP_SKINS
LSLA, U
CMSEL, S, COMP_SPARS
LSLA, U
LESIZE, ALL, , , 6
ALLSEL, ALL

! Ribs
! Set SKIP_RIB_MESH = 1 to disable rib meshing for debugging, 0 to enable
SKIP_RIB_MESH = 0

*IF, SKIP_RIB_MESH, EQ, 0, THEN
    CMSEL, S, COMP_RIBS
    AATT, 1, , 1, , 1
    MSHAPE, 1, 2D
    MSHKEY, 0
    SHPP, OFF
    ESIZE, 15      ! Use fine uniform mesh to bypass SMRTSIZE crash and make EDELE holes smooth
    AMESH, ALL
    SHPP, ON

*ENDIF
MSHAPE, 0, 2D

! Orient and Mesh Beams
*DIM, COMP_LIST, STRING, 24, 4
COMP_LIST(1,1) = 'COMP_STR_UPPER'
COMP_LIST(1,2) = 'COMP_STR_LOWER'
COMP_LIST(1,3) = 'COMP_FLANGE_UPPER'
COMP_LIST(1,4) = 'COMP_FLANGE_LOWER'

K_OR = 90000
K, K_OR, 0, 1000, 5000
D_OR = 100                         ! orientation KP distance [mm]

*DO, C_IDX, 1, 4
    CMSEL, S, %COMP_LIST(1,C_IDX)%
    *GET, LNUM, LINE, 0, NUM, MIN
    *DOWHILE, LNUM
        *IF, C_IDX, LE, 2, THEN
            SEC_NUM = 4    ! Stringer
        *ELSE
            SEC_NUM = 5    ! Spar Flange
        *ENDIF
        
        *GET, KP1, LINE, LNUM, KP, 1
        *GET, KP2, LINE, LNUM, KP, 2
        *GET, X1, KP, KP1, LOC, X
        *GET, Y1, KP, KP1, LOC, Y
        *GET, Z1, KP, KP1, LOC, Z
        *GET, X2, KP, KP2, LOC, X
        *GET, Y2, KP, KP2, LOC, Y
        *GET, Z2, KP, KP2, LOC, Z

        ! Spanwise line direction L
        LX = X2-X1
        LY = Y2-Y1
        LZ = Z2-Z1
        LMAG = SQRT(LX**2+LY**2+LZ**2)
        LX = LX/LMAG
        LY = LY/LMAG
        LZ = LZ/LMAG

        ! Chordwise skin tangent T at the rib station of KP1
        C_I = C_ROOT + (C_TIP-C_ROOT)*Y1/SPAN
        XF  = X1/C_I
        *IF, XF, GT, 1.0E-4, THEN
            T1 = 0.14845/SQRT(XF) - 0.12600
            T2 = -0.70320*XF + 0.85290*(XF**2)
            T3 = -0.40600*(XF**3)
            DYT = TSCALE*(T1 + T2 + T3)
        *ELSE
            DYT = 0.0              ! LE guard (no spar/stringer at x=0)
        *ENDIF
        
        *IF, C_IDX, EQ, 1, OR, C_IDX, EQ, 3, THEN
            SGN = 1.0              ! upper surface
        *ELSE
            SGN = -1.0             ! lower surface
        *ENDIF
        
        TX = 1.0
        TY = 0.0
        TZ = SGN*DYT

        ! Skin normal n = L x T
        NX = LY*TZ-LZ*TY
        NY = LZ*TX-LX*TZ
        NZ = LX*TY-LY*TX
        NMAG = SQRT(NX**2+NY**2+NZ**2)
        NX = NX/NMAG
        NY = NY/NMAG
        NZ = NZ/NMAG
        
        ! Force n to point INTO the airfoil box
        *IF, SGN*NZ, GT, 0, THEN
            NX = -NX
            NY = -NY
            NZ = -NZ
        *ENDIF

        ! Orientation KP: midpoint + D_OR*n  -> element z = n
        K_OR = K_OR + 1
        K, K_OR, (X1+X2)/2+D_OR*NX, (Y1+Y2)/2+D_OR*NY, (Z1+Z2)/2+D_OR*NZ

        LSEL, S, LINE, , LNUM
        LATT, 1, , 2, , K_OR, , SEC_NUM
        LMESH, LNUM
        
        CMSEL, S, %COMP_LIST(1,C_IDX)%
        *GET, LNUM, LINE, LNUM, NXTH
    *ENDDO
*ENDDO
ALLSEL, ALL

! ================================================================
!  DISPLAY SETTINGS
! ================================================================
/VIEW, 1, 1, 1, 1  ! Set isometric view
/ESHAPE, 1         ! Turn on 3D element shape rendering (crucial for beams)
EPLOT              ! Plot elements

! Merge nodes with generous tolerance to weld all unmerged topologies
ALLSEL, ALL
NUMMRG, NODE, 1.0
NUMCMP, NODE

/GRAPHICS, POWER
/ESHAPE, 1
/EDGE, 1, 1
EPLOT

! ================================================================
!  BLOCK 9: BOUNDARY CONDITIONS & LOADS
! ================================================================
/SOLU
ANTYPE, 0  ! Static Analysis

! Fix root
CSYS, 0
NSEL, S, LOC, Y, -1, 1
D, ALL, ALL, 0
ALLSEL, ALL

! Distributed Load (Simulating balancing tail load, 5 kPa)
! Apply only to Upper Skin (Z > 0) to prevent load cancellation
CMSEL, S, COMP_SKINS
ASEL, R, LOC, Z, 0.1, 1000
SFA, ALL, 1, PRES, 0.005
ALLSEL, ALL

! ================================================================
!  BLOCK 10: SOLVE & POST-PROCESS
! ================================================================
! Clean up unattached nodes to prevent singular matrix/license errors
/PREP7
ALLSEL, ALL
NSEL, U, ATTA
NDELE, ALL
ALLSEL, ALL

/SOLU
SOLVE
FINISH

/POST1
SET, LAST
/ESHAPE, 1
EPLOT

! Max Von Mises Stress
NSORT, S, EQV, 0, 0, ALL
*GET, SMAX, SORT, 0, MAX

! Tip Deflection
NSEL, S, LOC, Y, SPAN-50, SPAN+50
NSORT, U, Z, 0, 0, ALL
*GET, TIP_UZ, SORT, 0, MIN  ! Use MIN since aerodynamic load is downward
ALLSEL, ALL

*CFOPEN, HTP_Results, txt
*VWRITE, CONFIG, SMAX, TIP_UZ
('CONFIG:', F4.0, ' SMAX[MPa]:', F10.2, ' TIP_UZ[mm]:', F10.2)
*CFCLOS






