! =====================================================================
!  VERIFY_MODAL.mac — Master Stage 3b Model Verification Suite
!  Executes Unconstrained Free-Free Modal Analysis, Cantilever Modal
!  Analysis, and Component Mass Audit across CONFIG = 1, 2, 3
! =====================================================================
/CLEAR, NOSTART

! --- INITIALIZE OUTPUT CSV & SUMMARY HEADERS ---
*CFOPEN, STAGE3B_MODAL_FREE_FREE, csv
*VWRITE
('CFG,NODES,ELEMS,MASS_KG,F1,F2,F3,F4,F5,F6,F7,F8,F9,F10,F11,F12,RBM_MAX,PASS')
*CFCLOS

*CFOPEN, STAGE3B_MODAL_CANTILEVER, csv
*VWRITE
('CFG,N_RIB,N_SPAR,N_STR,MASS_KG,FC1_HZ,FC2_HZ,FC3_HZ,FC4_HZ,FC5_HZ,FC6_HZ')
*CFCLOS

*CFOPEN, STAGE3B_MASS_BREAKDOWN, csv
*VWRITE
('CFG,M_TOT_KG,M_SLV_KG,M_SKIN,M_SPARW,M_RIBW,M_STR,M_SPARF,M_RIBF,XCG,YCG,ZCG')
*CFCLOS

*CFOPEN, STAGE3B_VERIFICATION_SUMMARY, txt
*VWRITE
('STAGE 3b: HTP MULTI-CONFIGURATION MODAL & MASS VERIFICATION AUDIT')
*CFCLOS

! =====================================================================
!  1. VERIFY CONFIGURATION A (CONFIG = 1 : 14 Ribs, 3 Spars, 8 Stringers)
! =====================================================================
/CLEAR, NOSTART
CONFIG = 1
/INPUT, HTP_BUILD_CORE, mac
/INPUT, RUN_SINGLE_MODAL, mac

! =====================================================================
!  2. VERIFY CONFIGURATION B (CONFIG = 2 : 9 Ribs, 2 Spars, 8 Stringers)
! =====================================================================
/CLEAR, NOSTART
CONFIG = 2
/INPUT, HTP_BUILD_CORE, mac
/INPUT, RUN_SINGLE_MODAL, mac

! =====================================================================
!  3. VERIFY CONFIGURATION C (CONFIG = 3 : 7 Ribs, 2 Spars, 6 Stringers)
! =====================================================================
/CLEAR, NOSTART
CONFIG = 3
/INPUT, HTP_BUILD_CORE, mac
/INPUT, RUN_SINGLE_MODAL, mac
