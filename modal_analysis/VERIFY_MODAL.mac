! =====================================================================
!  VERIFY_MODAL.mac — Master Stage 3b Model Verification Suite
!  Executes Unconstrained Free-Free Modal Analysis (Table 3),
!  Cantilever Modal Analysis, Component Mass Audit, 3-Axis 1g Gravity
!  Load Verification (Tables 4, 5, 6), and Unit Displacement Check
!  across CONFIG = 1, 2, 3
! =====================================================================
/CLEAR, NOSTART

! --- INITIALIZE OUTPUT CSV & SUMMARY HEADERS IN modal_main_run_1/ ---
*CFOPEN, modal_main_run_1/STAGE3B_MODAL_FREE_FREE, csv
*VWRITE
('CFG,NODES,ELEMS,MASS_KG,F1,F2,F3,F4,F5,F6,F7,F8,F9,F10,F11,F12,RBM_MAX,PASS')
*CFCLOS

*CFOPEN, modal_main_run_1/STAGE3B_MODAL_CANTILEVER, csv
*VWRITE
('CFG,N_RIB,N_SPAR,N_STR,MASS_KG,FC1_HZ,FC2_HZ,FC3_HZ,FC4_HZ,FC5_HZ,FC6_HZ')
*CFCLOS

*CFOPEN, modal_main_run_1/STAGE3B_MASS_BREAKDOWN, csv
*VWRITE
('CFG,M_TOT_KG,M_SLV_KG,M_SKIN,M_SPARW,M_RIBW,M_STR,M_SPARF,M_RIBF,XCG,YCG,ZCG')
*CFCLOS

*CFOPEN, modal_main_run_1/STAGE3B_GRAVITY_1G_VERIFICATION, csv
*VWRITE
('CFG,MASS_TON,F_THEO_N,F_THEO_KN,GX_RX_N,GX_RY_N,GX_RZ_N,GX_RX_KN,ERR_GX_PCT,GY_RX_N,GY_RY_N,GY_RZ_N,GY_RY_KN,ERR_GY_PCT,GZ_RX_N,GZ_RY_N,GZ_RZ_N,GZ_RZ_KN,ERR_GZ_PCT')
*CFCLOS

*CFOPEN, modal_main_run_1/STAGE3B_STATIC_AND_UNIT_DISP, csv
*VWRITE
('CFG,GZ_UMX_MM,GZ_SMX_MPA,UNIT_UX_MIN,UNIT_UX_MAX,UNIT_SMX')
*CFCLOS

*CFOPEN, modal_main_run_1/STAGE3B_VERIFICATION_SUMMARY, txt
*VWRITE
('STAGE 3b: HTP MULTI-CONFIGURATION MODAL, MASS, UNIT DISPLACEMENT & 1g GRAVITY VERIFICATION AUDIT')
*CFCLOS

! =====================================================================
!  1. VERIFY CONFIGURATION A (CONFIG = 1 : 14 Ribs, 3 Spars, 8 Stringers)
! =====================================================================
/CLEAR, NOSTART
CONFIG = 1
/INPUT, HTP_BUILD_CORE, mac
/INPUT, RUN_SINGLE_MODAL, mac

! =====================================================================
!  2. VERIFY CONFIGURATION B (CONFIG = 2 : 9 Ribs, 2 Spars, 8 Stringers)
! =====================================================================
/CLEAR, NOSTART
CONFIG = 2
/INPUT, HTP_BUILD_CORE, mac
/INPUT, RUN_SINGLE_MODAL, mac

! =====================================================================
!  3. VERIFY CONFIGURATION C (CONFIG = 3 : 7 Ribs, 2 Spars, 6 Stringers)
! =====================================================================
/CLEAR, NOSTART
CONFIG = 3
/INPUT, HTP_BUILD_CORE, mac
/INPUT, RUN_SINGLE_MODAL, mac
