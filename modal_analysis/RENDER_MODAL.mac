MXPAND, 6, , , NO
CSYS, 0
NSEL, S, LOC, Y, -1.0, 1.0
D, ALL, ALL, 0
ALLSEL, ALL
SOLVE
FINISH

/POST1
/RGB, INDEX, 100, 100, 100, 0
/RGB, INDEX, 0, 0, 0, 15
/PLOPTS, INFO, 1
/PLOPTS, LEG1, 1
/PLOPTS, WINS, 0
/ESHAPE, 1
/EDGE, 1, 1
/DEVICE, VECTOR, 0
/VIEW, 1, 0.55, -0.70, 0.45
/VUP, 1, Z
/ANG, 1, 0

/SHOW, PNG, REV
/GFILE, 1920

! modal_cfg2000.png : Config B Internal Skeleton (Skin Hidden)
ALLSEL, ALL
ESEL, U, SEC, , 3
NSLE, S
/PNUM, SEC, 1
/NUM, 1
/TITLE, Config B [9-2-8] Internal Structural Framework (9 Ribs, 2 Spars, 8 Stringers)
EPLOT

! modal_cfg2001.png : Config B Cantilever Mode 1 (20.69 Hz)
ALLSEL, ALL
/PNUM, SEC, 0
/NUM, 0
/EDGE, 1, 0
SET, 1, 1
/TITLE, Config B [9-2-8] Cantilever Mode 1 (fc1 = 20.69 Hz - 1st Vertical Bending)
PLNSOL, U, SUM, 0, 1.0
/SHOW, CLOSE
FINISH

