! =====================================================================
!  RENDER_STATIC_LOADS.mac — Stage 2b High-Resolution Visual Generator
!  Generates Load Vectors, Deformed Shapes & Von Mises Stress plots
!  for CONFIG = 1, 2, 3
!  Outputs directly to: load_sfbm/visual_load/
! =====================================================================
/CWD, 'E:\___ KMITL ___\Y3\Aircraft Structure\Mini Ansys Project\Parametric APDL-Based Horizontal Tailplane Structural Analysis and Optimization\Ansys_Scripts\load_sfbm\visual_load'

! =====================================================================
!  CONFIGURATION 1: (14 Ribs, 3 Spars, 8 Stringers)
! =====================================================================
/CLEAR, NOSTART
CONFIG = 1
/INPUT, HTP_PARAMETRIC, mac

/POST1
SET, LAST

/GRAPHICS, FULL
/RGB, INDEX, 100, 100, 100, 0
/RGB, INDEX, 0, 0, 0, 15
/PLOPTS, INFO, 1
/PLOPTS, LEG1, 1
/PLOPTS, WINS, 0
/PLOPTS, FRAME, 0
/PLOPTS, TITLE, 1
/ESHAPE, 1
/EDGE, 1, 0
/DEVICE, VECTOR, 0
/VIEW, 1, 0.55, -0.70, 0.45
/VUP, 1, Z
/ANG, 1, 0
/AUTO, 1

/SHOW, PNG, REV
/GFILE, 1920

! Plot 1: Aerodynamic Nodal Forces & Cantilever Root BC
/TITLE, HTP Config 1 [Case D_fwd] Applied Aerodynamic Nodal Forces & Cantilever BC
/PBC, F, , 1
/PBC, U, , 1
EPLOT
/PBC, ALL, , 0

! Plot 2: Deformed vs Undeformed Shape with Total Displacement Contour (DMX)
/TITLE, HTP Config 1 [Case D_fwd] Deformed Shape & Displacement Vector (DMX)
PLNSOL, U, SUM, 1

! Plot 3: Von Mises Equivalent Stress Contour (SEQV)
/TITLE, HTP Config 1 [Case D_fwd] Von Mises Equivalent Stress (SEQV)
PLNSOL, S, EQV, 0

/SHOW, CLOSE


