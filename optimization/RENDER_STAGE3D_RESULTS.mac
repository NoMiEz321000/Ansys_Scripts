! ==============================================================================
! RENDER_STAGE3D_RESULTS.mac — Publication-Quality Report Visualizer
! Generates 10 Report-Ready Visuals with Horizontal Bottom Contour Bar
! and Suppressed Right-Hand Legend Block (PowerGraphics box removed):
!   1. cfg1_opt_regime1a_dmx.png       (0 to 7.2 mm DMX)
!   2. cfg1_opt_regime1a_seqv.png      (0 to 30.0 MPa SEQV)
!   3. cfg1_buckle_mode1.png           (Buckling Mode 1, L1 = -2.4891)
!   4. cfg2_opt_regime1a_dmx.png       (0 to 7.2 mm DMX)
!   5. cfg2_opt_regime1a_seqv.png      (0 to 45.0 MPa SEQV)
!   6. cfg2_buckle_mode1.png           (Buckling Mode 1, L1 = -2.2074)
!   7. cfg3_baseline_buckle_mode1.png  (Baseline Mode 1, L1 = -1.3257 - Deficit)
!   8. cfg3_opt_regime1a_dmx.png       (0 to 7.2 mm DMX)
!   9. cfg3_opt_regime1a_seqv.png      (0 to 55.0 MPa SEQV)
!  10. cfg3_opt_regime1a_buckle_mode1.png (Optimized Mode 1, L1 = -1.6012 - Pass)
!
! Execution Working Directory: Ansys_Scripts/optimization/
! ==============================================================================

! Master Report Display Macro (Re-applied inside /POST1 before every plot)
*CREATE, _SET_REPORT_PLOT, mac
    /RGB, INDEX, 100, 100, 100, 0
    /RGB, INDEX, 0, 0, 0, 15
    /VIEW, 1, 0.55, -0.70, 0.45
    /VUP, 1, Z
    /ANG, 1, 0
    /AUTO, 1
    /ESHAPE, 1
    /EDGE, 1, 0
    /DEVICE, VECTOR, 0
    /GRAPHICS, POWER

    /PLOPTS, INFO, 3
    /PLOPTS, LEG1, 0
    /PLOPTS, LEG2, 0
    /PLOPTS, LEG3, 1
    /PLOPTS, FRAME, 0
    /PLOPTS, TITLE, 0
    /PLOPTS, MINM, 1
    /PLOPTS, DATE, 0
    /PLOPTS, LOGO, 0
    /PLOPTS, WINS, 1
    /UDOC, 1, CNTR, BOTTOM

    /SHOW, PNG, , 0
    PNGR, COMP, 1, -1
    PNGR, ORIENT, HORIZ
    PNGR, COLOR, 2
    PNGR, TMOD, 1
    /GFILE, 1920
*END


! ==============================================================================
! 1. CONFIGURATION 1 REGIME 1A (Optimized)
! ==============================================================================
RESUME, '_scratch_base_cfg1', 'db'
T_SKIN = 2.05 $ T_SPAR_WEB = 2.50 $ T_RIB_WEB = 1.20 $ STR_T = 1.60 $ SPAR_FT = 2.50 $ RIB_FT = 0.80
RUN_BUCKLE_FLAG = 0
/INPUT, UPDATE_SECTIONS_AND_SOLVE, mac

/POST1
SET, LAST
ALLSEL, ALL

! Plot 1: DMX (0 to 7.2 mm, step 0.8 mm)
/INPUT, _SET_REPORT_PLOT, mac
/CONTOUR, 1, 9, 0, 0.8, 7.2
PLNSOL, U, SUM, 1

! Plot 2: Von Mises Stress (0 to 30 MPa)
/CONTOUR, 1, 9, 0, , 30.0
PLNSOL, S, EQV, 0
/SHOW, CLOSE
FINISH

! Buckling Solve
/SOLU
ANTYPE, BUCKLE
BUCOPT, LANB, 5
MXPAND, 5, , , YES
ALLSEL, ALL
SOLVE
FINISH

/POST1
SET, 1, 1
ALLSEL, ALL

! Plot 3: Buckling Mode 1 (L1 = -2.4891)
/INPUT, _SET_REPORT_PLOT, mac
/CONTOUR, 1, 9, 0, , 1.0
PLNSOL, U, SUM, 1
/SHOW, CLOSE
FINISH


! ==============================================================================
! 2. CONFIGURATION 2 REGIME 1A (Optimized)
! ==============================================================================
RESUME, '_scratch_base_cfg2', 'db'
T_SKIN = 2.12 $ T_SPAR_WEB = 2.50 $ T_RIB_WEB = 1.20 $ STR_T = 1.60 $ SPAR_FT = 2.50 $ RIB_FT = 0.80
RUN_BUCKLE_FLAG = 0
/INPUT, UPDATE_SECTIONS_AND_SOLVE, mac

/POST1
SET, LAST
ALLSEL, ALL

! Plot 4: DMX (0 to 7.2 mm, step 0.8 mm)
/INPUT, _SET_REPORT_PLOT, mac
/CONTOUR, 1, 9, 0, 0.8, 7.2
PLNSOL, U, SUM, 1

! Plot 5: Von Mises Stress (0 to 45 MPa)
/CONTOUR, 1, 9, 0, , 45.0
PLNSOL, S, EQV, 0
/SHOW, CLOSE
FINISH

! Buckling Solve
/SOLU
ANTYPE, BUCKLE
BUCOPT, LANB, 5
MXPAND, 5, , , YES
ALLSEL, ALL
SOLVE
FINISH

/POST1
SET, 1, 1
ALLSEL, ALL

! Plot 6: Buckling Mode 1 (L1 = -2.2074)
/INPUT, _SET_REPORT_PLOT, mac
/CONTOUR, 1, 9, 0, , 1.0
PLNSOL, U, SUM, 1
/SHOW, CLOSE
FINISH


! ==============================================================================
! 3. CONFIGURATION 3 BASELINE (Buckling Deficit State, L1 = -1.3257)
! ==============================================================================
RESUME, '_scratch_base_cfg3', 'db'
T_SKIN = 2.00 $ T_SPAR_WEB = 3.00 $ T_RIB_WEB = 2.00 $ STR_T = 1.60 $ SPAR_FT = 2.50 $ RIB_FT = 1.00
RUN_BUCKLE_FLAG = 0
/INPUT, UPDATE_SECTIONS_AND_SOLVE, mac

! Buckling Solve
/SOLU
ANTYPE, BUCKLE
BUCOPT, LANB, 5
MXPAND, 5, , , YES
ALLSEL, ALL
SOLVE
FINISH

/POST1
SET, 1, 1
ALLSEL, ALL

! Plot 7: Baseline Buckling Mode 1 (L1 = -1.3257)
/INPUT, _SET_REPORT_PLOT, mac
/CONTOUR, 1, 9, 0, , 1.0
PLNSOL, U, SUM, 1
/SHOW, CLOSE
FINISH


! ==============================================================================
! 4. CONFIGURATION 3 REGIME 1A (Optimized Passing State, L1 = -1.6012)
! ==============================================================================
RESUME, '_scratch_base_cfg3', 'db'
T_SKIN = 2.18 $ T_SPAR_WEB = 2.50 $ T_RIB_WEB = 1.50 $ STR_T = 1.60 $ SPAR_FT = 2.50 $ RIB_FT = 0.80
RUN_BUCKLE_FLAG = 0
/INPUT, UPDATE_SECTIONS_AND_SOLVE, mac

/POST1
SET, LAST
ALLSEL, ALL

! Plot 8: DMX (0 to 7.2 mm, step 0.8 mm)
/INPUT, _SET_REPORT_PLOT, mac
/CONTOUR, 1, 9, 0, 0.8, 7.2
PLNSOL, U, SUM, 1

! Plot 9: Von Mises Stress (0 to 55 MPa)
/CONTOUR, 1, 9, 0, , 55.0
PLNSOL, S, EQV, 0
/SHOW, CLOSE
FINISH

! Buckling Solve
/SOLU
ANTYPE, BUCKLE
BUCOPT, LANB, 5
MXPAND, 5, , , YES
ALLSEL, ALL
SOLVE
FINISH

/POST1
SET, 1, 1
ALLSEL, ALL

! Plot 10: Optimized Buckling Mode 1 (L1 = -1.6012)
/INPUT, _SET_REPORT_PLOT, mac
/CONTOUR, 1, 9, 0, , 1.0
PLNSOL, U, SUM, 1
/SHOW, CLOSE
FINISH

/DELETE, _SET_REPORT_PLOT, mac
