! ==============================================================================
! RUN_STAGE3D_SENSITIVITY_SWEEP.mac
! Purpose: Calculate Design Sensitivity Gradients (dM/dxi, d|TIP_UZ|/dxi,
!          dSigmaMax/dxi, d|lambda_1|/dxi) across all 3 Configurations
! Execution Cwd: Ansys_Scripts/optimization/
! CRITICAL RULE: Never put a space before '*' in multiplication (A*B, never A * B)!
! ==============================================================================

*CFOPEN, result/STAGE3D_SENSITIVITY_MATRIX, csv
*VWRITE
('CFG,DV_NAME,X0_MM,DX_MM,DM_DX,DUZ_DX,DSMAX_DX,DLAMBDA_DX')
*CFCLOS

*CREATE, _SENS_SWEEP_CFG, mac
    ! --- 1. Baseline Solve ---
    T_RIB_WEB  = 2.00
    T_SPAR_WEB = 3.00
    T_SKIN     = 2.00
    STR_T      = 1.60
    SPAR_FT    = 2.50
    RIB_FT     = 1.00
    RUN_BUCKLE_FLAG = 1

    /INPUT, UPDATE_SECTIONS_AND_SOLVE, mac

    M0  = M_MTOT_KG
    UZ0 = ABS(TIP_UZ_V)
    S0  = P_RFL6
    L0  = ABS(B_L1)
    DX_V = 0.20

    ! --- 2. Perturb T_SKIN ---
    T_SKIN = 2.00+DX_V
    /INPUT, UPDATE_SECTIONS_AND_SOLVE, mac
    DM_DX = (M_MTOT_KG-M0)/DX_V
    DUZ_DX = (ABS(TIP_UZ_V)-UZ0)/DX_V
    DS_DX = (P_RFL6-S0)/DX_V
    DL_DX = (ABS(B_L1)-L0)/DX_V
    *CFOPEN, result/STAGE3D_SENSITIVITY_MATRIX, csv, , APPEND
    *VWRITE, CUR_CFG, 'T_SKIN  ', 2.00, DX_V, DM_DX, DUZ_DX, DS_DX, DL_DX
(F2.0,',',A8,',',F6.2,',',F6.2,',',F10.4,',',F10.4,',',F10.4,',',F10.4)
    *CFCLOS
    T_SKIN = 2.00

    ! --- 3. Perturb T_SPAR_WEB ---
    T_SPAR_WEB = 3.00+DX_V
    /INPUT, UPDATE_SECTIONS_AND_SOLVE, mac
    DM_DX = (M_MTOT_KG-M0)/DX_V
    DUZ_DX = (ABS(TIP_UZ_V)-UZ0)/DX_V
    DS_DX = (P_RFL6-S0)/DX_V
    DL_DX = (ABS(B_L1)-L0)/DX_V
    *CFOPEN, result/STAGE3D_SENSITIVITY_MATRIX, csv, , APPEND
    *VWRITE, CUR_CFG, 'T_SPAR_W', 3.00, DX_V, DM_DX, DUZ_DX, DS_DX, DL_DX
(F2.0,',',A8,',',F6.2,',',F6.2,',',F10.4,',',F10.4,',',F10.4,',',F10.4)
    *CFCLOS
    T_SPAR_WEB = 3.00

    ! --- 4. Perturb T_RIB_WEB ---
    T_RIB_WEB = 2.00+DX_V
    /INPUT, UPDATE_SECTIONS_AND_SOLVE, mac
    DM_DX = (M_MTOT_KG-M0)/DX_V
    DUZ_DX = (ABS(TIP_UZ_V)-UZ0)/DX_V
    DS_DX = (P_RFL6-S0)/DX_V
    DL_DX = (ABS(B_L1)-L0)/DX_V
    *CFOPEN, result/STAGE3D_SENSITIVITY_MATRIX, csv, , APPEND
    *VWRITE, CUR_CFG, 'T_RIB_W ', 2.00, DX_V, DM_DX, DUZ_DX, DS_DX, DL_DX
(F2.0,',',A8,',',F6.2,',',F6.2,',',F10.4,',',F10.4,',',F10.4,',',F10.4)
    *CFCLOS
    T_RIB_WEB = 2.00

    ! --- 5. Perturb STR_T ---
    STR_T = 1.60+DX_V
    /INPUT, UPDATE_SECTIONS_AND_SOLVE, mac
    DM_DX = (M_MTOT_KG-M0)/DX_V
    DUZ_DX = (ABS(TIP_UZ_V)-UZ0)/DX_V
    DS_DX = (P_RFL6-S0)/DX_V
    DL_DX = (ABS(B_L1)-L0)/DX_V
    *CFOPEN, result/STAGE3D_SENSITIVITY_MATRIX, csv, , APPEND
    *VWRITE, CUR_CFG, 'STR_T   ', 1.60, DX_V, DM_DX, DUZ_DX, DS_DX, DL_DX
(F2.0,',',A8,',',F6.2,',',F6.2,',',F10.4,',',F10.4,',',F10.4,',',F10.4)
    *CFCLOS
    STR_T = 1.60

    ! --- 6. Perturb SPAR_FT ---
    SPAR_FT = 2.50+DX_V
    /INPUT, UPDATE_SECTIONS_AND_SOLVE, mac
    DM_DX = (M_MTOT_KG-M0)/DX_V
    DUZ_DX = (ABS(TIP_UZ_V)-UZ0)/DX_V
    DS_DX = (P_RFL6-S0)/DX_V
    DL_DX = (ABS(B_L1)-L0)/DX_V
    *CFOPEN, result/STAGE3D_SENSITIVITY_MATRIX, csv, , APPEND
    *VWRITE, CUR_CFG, 'SPAR_FT ', 2.50, DX_V, DM_DX, DUZ_DX, DS_DX, DL_DX
(F2.0,',',A8,',',F6.2,',',F6.2,',',F10.4,',',F10.4,',',F10.4,',',F10.4)
    *CFCLOS
    SPAR_FT = 2.50

    ! --- 7. Perturb RIB_FT ---
    RIB_FT = 1.00+DX_V
    /INPUT, UPDATE_SECTIONS_AND_SOLVE, mac
    DM_DX = (M_MTOT_KG-M0)/DX_V
    DUZ_DX = (ABS(TIP_UZ_V)-UZ0)/DX_V
    DS_DX = (P_RFL6-S0)/DX_V
    DL_DX = (ABS(B_L1)-L0)/DX_V
    *CFOPEN, result/STAGE3D_SENSITIVITY_MATRIX, csv, , APPEND
    *VWRITE, CUR_CFG, 'RIB_FT  ', 1.00, DX_V, DM_DX, DUZ_DX, DS_DX, DL_DX
(F2.0,',',A8,',',F6.2,',',F6.2,',',F10.4,',',F10.4,',',F10.4,',',F10.4)
    *CFCLOS
    RIB_FT = 1.00
*END

! --- Run Sweep for Config 1 ---
RESUME, '_scratch_base_cfg1', 'db'
CUR_CFG = 1
/INPUT, _SENS_SWEEP_CFG, mac

! --- Run Sweep for Config 2 ---
RESUME, '_scratch_base_cfg2', 'db'
CUR_CFG = 2
/INPUT, _SENS_SWEEP_CFG, mac

! --- Run Sweep for Config 3 ---
RESUME, '_scratch_base_cfg3', 'db'
CUR_CFG = 3
/INPUT, _SENS_SWEEP_CFG, mac

/DELETE, _SENS_SWEEP_CFG, mac
