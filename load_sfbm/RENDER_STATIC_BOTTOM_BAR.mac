! =====================================================================
!  RENDER_STATIC_BOTTOM_BAR.mac — Stage 2b Publication-Quality Visuals
!  Generates Load Vectors, Deformed Shapes & Von Mises Stress plots
!  with Bottom Horizontal Contour Bar and Suppressed Right Legend Block
!  for CONFIG = 1, 2, 3
! =====================================================================

! =====================================================================
!  CONFIGURATION 1: (14 Ribs, 3 Spars, 8 Stringers)
! =====================================================================
/CLEAR, NOSTART
CONFIG = 1
/INPUT, HTP_PARAMETRIC, mac

/POST1
SET, LAST

/GRAPHICS, POWER
/RGB, INDEX, 100, 100, 100, 0
/RGB, INDEX, 0, 0, 0, 15
/VIEW, 1, 0.55, -0.70, 0.45
/VUP, 1, Z
/ANG, 1, 0
/AUTO, 1
/ESHAPE, 1
/EDGE, 1, 0
/DEVICE, VECTOR, 0

/PLOPTS, INFO, 3
/PLOPTS, LEG1, 0
/PLOPTS, LEG2, 0
/PLOPTS, LEG3, 1
/PLOPTS, FRAME, 0
/PLOPTS, TITLE, 0
/PLOPTS, MINM, 1
/PLOPTS, DATE, 0
/PLOPTS, LOGO, 0
/PLOPTS, WINS, 1
/UDOC, 1, CNTR, BOTTOM

/SHOW, PNG, , 0
PNGR, COMP, 1, -1
PNGR, ORIENT, HORIZ
PNGR, COLOR, 2
PNGR, TMOD, 1
/GFILE, 1920

! Cfg 1 - Plot 1: Aerodynamic Nodal Forces & Cantilever Root BC
/PBC, F, , 1
/PBC, U, , 1
EPLOT
/PBC, ALL, , 0

! Cfg 1 - Plot 2: Deformed vs Undeformed Shape with Total Displacement Contour (DMX)
PLNSOL, U, SUM, 1

! Cfg 1 - Plot 3: Von Mises Equivalent Stress Contour (SEQV)
PLNSOL, S, EQV, 0

/SHOW, CLOSE


