! =====================================================================
!  RENDER_LOADS_BC_BLUE.mac
!  Renders High-Resolution Applied Loads & Cantilever Root BC
!  with Deep Blue Displacement Constraints (/COLOR, U, BLUE)
!  for CONFIG = 1, 2, 3
! =====================================================================

! =====================================================================
!  CONFIGURATION 1: (14 Ribs, 3 Spars, 8 Stringers)
! =====================================================================
/CLEAR, NOSTART
CONFIG = 1
/INPUT, HTP_PARAMETRIC, mac

/POST1
SET, LAST

/GRAPHICS, POWER
/RGB, INDEX, 100, 100, 100, 0
/RGB, INDEX, 0, 0, 0, 15
/VIEW, 1, 0.55, -0.70, 0.45
/VUP, 1, Z
/ANG, 1, 0
/AUTO, 1
/ESHAPE, 1
/EDGE, 1, 0
/DEVICE, VECTOR, 0

/PLOPTS, INFO, 3
/PLOPTS, LEG1, 0
/PLOPTS, LEG2, 0
/PLOPTS, LEG3, 1
/PLOPTS, FRAME, 0
/PLOPTS, TITLE, 0
/PLOPTS, MINM, 0
/PLOPTS, DATE, 0
/PLOPTS, LOGO, 0
/PLOPTS, WINS, 1

/SHOW, PNG, , 0
PNGR, COMP, 1, -1
PNGR, ORIENT, HORIZ
PNGR, COLOR, 2
PNGR, TMOD, 1
/GFILE, 1920

/COLOR, U, BLUE
/PBC, F, , 1
/PBC, U, , 1
EPLOT
/PBC, ALL, , 0
/SHOW, CLOSE


! =====================================================================
!  CONFIGURATION 2: (9 Ribs, 2 Spars, 8 Stringers)
! =====================================================================
/CLEAR, NOSTART
CONFIG = 2
/INPUT, HTP_PARAMETRIC, mac

/POST1
SET, LAST

/GRAPHICS, POWER
/RGB, INDEX, 100, 100, 100, 0
/RGB, INDEX, 0, 0, 0, 15
/VIEW, 1, 0.55, -0.70, 0.45
/VUP, 1, Z
/ANG, 1, 0
/AUTO, 1
/ESHAPE, 1
/EDGE, 1, 0
/DEVICE, VECTOR, 0

/PLOPTS, INFO, 3
/PLOPTS, LEG1, 0
/PLOPTS, LEG2, 0
/PLOPTS, LEG3, 1
/PLOPTS, FRAME, 0
/PLOPTS, TITLE, 0
/PLOPTS, MINM, 0
/PLOPTS, DATE, 0
/PLOPTS, LOGO, 0
/PLOPTS, WINS, 1

/SHOW, PNG, , 0
PNGR, COMP, 1, -1
PNGR, ORIENT, HORIZ
PNGR, COLOR, 2
PNGR, TMOD, 1
/GFILE, 1920

/COLOR, U, BLUE
/PBC, F, , 1
/PBC, U, , 1
EPLOT
/PBC, ALL, , 0
/SHOW, CLOSE


! =====================================================================
!  CONFIGURATION 3: (7 Ribs, 2 Spars, 6 Stringers)
! =====================================================================
/CLEAR, NOSTART
CONFIG = 3
/INPUT, HTP_PARAMETRIC, mac

/POST1
SET, LAST

/GRAPHICS, POWER
/RGB, INDEX, 100, 100, 100, 0
/RGB, INDEX, 0, 0, 0, 15
/VIEW, 1, 0.55, -0.70, 0.45
/VUP, 1, Z
/ANG, 1, 0
/AUTO, 1
/ESHAPE, 1
/EDGE, 1, 0
/DEVICE, VECTOR, 0

/PLOPTS, INFO, 3
/PLOPTS, LEG1, 0
/PLOPTS, LEG2, 0
/PLOPTS, LEG3, 1
/PLOPTS, FRAME, 0
/PLOPTS, TITLE, 0
/PLOPTS, MINM, 0
/PLOPTS, DATE, 0
/PLOPTS, LOGO, 0
/PLOPTS, WINS, 1

/SHOW, PNG, , 0
PNGR, COMP, 1, -1
PNGR, ORIENT, HORIZ
PNGR, COLOR, 2
